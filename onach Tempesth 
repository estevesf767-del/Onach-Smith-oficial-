<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#050505;
    color:white;
    overflow-x:hidden;
}

/* Fundo */
body::before{
    content:"";
    position:fixed;
    inset:0;
    background:
        linear-gradient(rgba(255,0,0,.04) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,0,0,.04) 1px,transparent 1px);
    background-size:40px 40px;
    pointer-events:none;
    z-index:-1;
}

/* Cabeçalho */
header{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:30px 20px;
    background:
        radial-gradient(circle at center,rgba(180,0,0,.25),transparent 45%),
        #050505;
}

.container{
    width:100%;
    max-width:1000px;
    margin:auto;
}

.logo{
    width:130px;
    height:130px;
    border:3px solid #ff2020;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto 25px;
    font-size:65px;
    font-weight:bold;
    color:#ff2020;
    box-shadow:
        0 0 20px #ff2020,
        inset 0 0 20px rgba(255,0,0,.3);
    animation:pulse 2s infinite;
}

@keyframes pulse{
    0%,100%{
        transform:scale(1);
        box-shadow:0 0 20px #ff2020;
    }
    50%{
        transform:scale(1.06);
        box-shadow:0 0 45px #ff2020;
    }
}

h1{
    font-size:clamp(40px,10vw,80px);
    letter-spacing:5px;
}

.red{
    color:#ff2020;
}

.subtitle{
    margin-top:15px;
    font-size:20px;
    color:#ccc;
}

.typing{
    margin:25px 0;
    color:#ff3030;
    font-size:18px;
}

/* Botões */
.buttons{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:12px;
    margin-top:25px;
}

.btn{
    text-decoration:none;
    color:white;
    border:1px solid #ff2020;
    padding:13px 22px;
    border-radius:30px;
    transition:.3s;
    background:rgba(255,0,0,.08);
}

.btn:hover{
    background:#ff2020;
    box-shadow:0 0 25px #ff2020;
    transform:translateY(-3px);
}

/* Seções */
section{
    padding:80px 20px;
}

.section-title{
    text-align:center;
    font-size:35px;
    margin-bottom:45px;
}

.section-title span{
    color:#ff2020;
}

/* Sobre */
.about{
    max-width:850px;
    margin:auto;
    text-align:center;
    color:#ccc;
    line-height:1.8;
    font-size:18px;
}

/* Cards */
.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    max-width:1000px;
    margin:auto;
}

.card{
    padding:30px 20px;
    background:linear-gradient(145deg,#111,#080808);
    border:1px solid #222;
    border-radius:15px;
    text-align:center;
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    border-color:#ff2020;
    box-shadow:0 0 25px rgba(255,0,0,.25);
}

.card .icon{
    font-size:45px;
    margin-bottom:15px;
}

.card h3{
    margin-bottom:12px;
    color:#ff3030;
}

.card p{
    color:#aaa;
    line-height:1.6;
}

/* Projeto */
.project{
    max-width:850px;
    margin:auto;
    border:1px solid #222;
    border-radius:18px;
    padding:35px;
    background:#0c0c0c;
    text-align:center;
}

.project h3{
    color:#ff2020;
    font-size:28px;
    margin-bottom:15px;
}

.project p{
    color:#bbb;
    line-height:1.7;
}

/* Contato */
.contact{
    text-align:center;
}

.contact p{
    color:#aaa;
    margin:10px;
}

/* Rodapé */
footer{
    text-align:center;
    padding:30px 20px;
    border-top:1px solid #222;
    color:#777;
}

footer span{
    color:#ff2020;
}

/* Animação de entrada */
.fade{
    opacity:0;
    transform:translateY(25px);
    animation:show 1s forwards;
}

@keyframes show{
    to{
        opacity:1;
        transform:translateY(0);
    }
}
</style>
</head>

